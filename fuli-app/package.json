{
  "name": "fuli-desktop",
  "version": "1.0.0",
  "description": "Fuli Desktop — AI screen & browser operator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "build:win": "node build.js --platform=win32 --arch=x64",
    "build:mac": "node build.js --platform=darwin --arch=arm64",
    "test:planner": "node test-planner.js",
    "evs:signup": "../.evs-venv/bin/python -m castlabs_evs.account signup",
    "evs:confirm": "../.evs-venv/bin/python -m castlabs_evs.account confirm-signup"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "github:castlabs/electron-releases#v36.9.5+wvcus"
  }
}
