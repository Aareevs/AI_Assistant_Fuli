# ===========================================================================
# Fuli AI Assistant – Environment Variables
# ===========================================================================

# Assistant & User Identity
SERVER_NAME="Fuli"
USER_NAME="Aareev"

# LiveKit Cloud
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# LLM Providers
GOOGLE_API_KEY="your-google-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
GROQ_API_KEY=""

# STT & TTS Providers
SARVAM_API_KEY="your-sarvam-api-key"
DEEPGRAM_API_KEY=""

# Spotify (free: developer.spotify.com/dashboard -> Create app) — powers the Fuli player search, cover art & track lists
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Google (Calendar, Gmail, YouTube) — OAuth "Desktop app" client from console.cloud.google.com (see README)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
